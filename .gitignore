local.properties
# A JVM crash log, if the Gradle daemon or the IDE ever dies mid-build. It lands next to the module,
# not in build/, so it has to be named here or it gets committed by accident.
hs_err_pid*.log
replay_pid*.log
# CLI build output captured to a file at the repo root during scripted runs.
*-build.log
