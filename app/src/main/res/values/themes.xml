<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      The window background is the app's own paper colour rather than the platform default, so the first
      frame of a cold start is already the colour the app is about to paint. With the default value that
      frame is white, which on a dark-theme phone is a visible flash on every launch.
    -->
    <style name="Theme.LensSpent" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/lensspent_window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
