<?xml version="1.0" encoding="utf-8"?>
<!--
  The mark: a lens over a rising bar chart. It reads as one shape at 48dp and is drawn from strokes
  rather than filled paths, so the round caps survive the mask on every launcher shape.

  Everything sits inside the 66dp safe zone (radius 33 from the 54,54 centre) so no part of it is
  clipped by a circular, squircle or teardrop mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- The lens ring: a full circle drawn as two semicircle arcs from its left edge. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M33,51a19,19 0 1,0 38,0a19,19 0 1,0 -38,0" />

    <!-- The handle, continuing the ring's stroke at 45 degrees. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:pathData="M66.4,64.4L76,74" />

    <!-- The chart inside the lens: three bars, the tallest in the accent teal. -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFBFE3F4"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M44,51V58" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFE6F4FB"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M52,46V58" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FF5FD8CB"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M60,41V58" />
</vector>
