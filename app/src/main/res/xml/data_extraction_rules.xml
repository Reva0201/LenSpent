<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) cloud backup and device-transfer policy.

  Decision: personal expense data is NOT backed up and NOT transferred to a new device.

  Excluding the ledger from cloud backup is the obvious half. Excluding it from device-transfer is
  the deliberate half: a transfer is still a copy leaving the app's control, and the receipt images
  plus OCR text would travel with it. A user who wants their history on a new phone can use the
  explicit CSV export, which they choose and can see.

  `root` covers the app's whole private data directory in both sections; the named exclusions are
  kept so a reader can see exactly what was considered. `cache` is not listed because the platform
  does not back it up and it is not a valid domain here.

  See backup_rules.xml for the API < 31 equivalent. android:allowBackup is false as a default; these
  rules are what makes the decision explicit and reviewable rather than incidental.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="database" path="lensspent.db" />
        <exclude domain="database" path="lensspent.db-shm" />
        <exclude domain="database" path="lensspent.db-wal" />
        <exclude domain="file" path="datastore/user_preferences.preferences_pb" />
        <exclude domain="file" path="receipts/" />
    </cloud-backup>

    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="database" path="lensspent.db" />
        <exclude domain="database" path="lensspent.db-shm" />
        <exclude domain="database" path="lensspent.db-wal" />
        <exclude domain="file" path="datastore/user_preferences.preferences_pb" />
        <exclude domain="file" path="receipts/" />
    </device-transfer>
</data-extraction-rules>
